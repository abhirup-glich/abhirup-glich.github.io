# 2. Base Auth URL
# In local development: http://localhost:5173
# In production on Vercel: https://theabhirupportfolio.vercel.app
AUTH_URL=http://localhost:5173

# 3. Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client IDs (Web application)
#
# Authorized JavaScript Origins:
#   - http://localhost:5173
#   - https://theabhirupportfolio.vercel.app
#
# Authorized Redirect URIs:
#   - http://localhost:5173/api/auth/callback/google
#   - https://theabhirupportfolio.vercel.app/api/auth/callback/google
